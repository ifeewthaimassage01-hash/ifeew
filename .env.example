# Supabase — copy to .env and fill in
# Get values from: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_ME

# Cloudinary (unsigned upload for receipts/slips)
# Dashboard > Settings > Upload > Upload presets (create unsigned preset, Signing Mode = unsigned)
VITE_CLOUDINARY_CLOUD_NAME=PASTE_ME
VITE_CLOUDINARY_UPLOAD_PRESET=PASTE_ME
# Branch (single branch for now, keep 'main'; future branches use their own id)
VITE_BRANCH_ID=main

# Web Push (admin only) — public key คู่กับ VAPID_PRIVATE_KEY (private อยู่ฝั่ง server secret เท่านั้น)
VITE_VAPID_PUBLIC_KEY=BG2ASLe-rzDXfCBax18v3tDO7AkqQo67VBBuBMvhldQwxPTrSZmoCytXUrMikcCR6BlDnVjkG71-jp8UrXcoOHM
